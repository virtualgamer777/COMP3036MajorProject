@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@* @inject NavigationManager Navigation *@
@* @inject HttpClient Http *@
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span><NavLink href="purchases">Hello @context.User.FindFirst(ClaimTypes.Name)?.Value</NavLink></span>
                    @* <NavLink href="logout">Sign out</NavLink> *@
                    @*This script was added to deal with an architectural issue resulting in c# code being unexecutable*@
                    <script>
                        async function signOut() {
                            try {
                                //console.log('signOut -> calling DELETE /api/logout');
                                const res = await fetch('/api/logout', {
                                    method: 'DELETE',
                                    credentials: 'same-origin'
                                });
                                //console.log('logout response', res.status, res.statusText);
                                if (res.ok) {
                                    // successful sign-out - redirect to home
                                    window.location.href = '/';
                                } else {
                                    alert('Sign out failed: ' + res.status + ' ' + res.statusText);
                                }
                            } catch (err) {
                                //console.error('signOut fetch failed', err);
                                //alert('Sign out request failed (see console).');
                            }
                        }
                    </script>
                    <button class="btn btn-link" onclick="signOut()">Sign out</button>
                    <NavLink href="cart">
                        <span>Cart</span>
                    </NavLink>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="login">Sign in</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
    
</div>