@using System.ComponentModel.DataAnnotations
@inject Database.Data DataService
@inject NavigationManager Navigation

<div class="listing-form">
    <h2>@(IsEditMode ? "Edit Listing" : "Create Listing")</h2>

    <EditForm Model="model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label" for="item-name">Item Name</label>
            <InputText id="item-name" class="form-control" @bind-Value="model.ItemName" />
            <ValidationMessage For="@(() => model.ItemName)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="item-description">Description</label>
            <InputTextArea id="item-description" class="form-control" @bind-Value="model.ItemDescription" rows="4" />
            <ValidationMessage For="@(() => model.ItemDescription)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="item-image">Image URL</label>
            <InputText id="item-image" class="form-control" @bind-Value="model.Image" />
            <ValidationMessage For="@(() => model.Image)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="item-price">Price (in cents)</label>
            <InputNumber id="item-price" class="form-control" @bind-Value="model.Price" />
            <ValidationMessage For="@(() => model.Price)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="item-quantity">Quantity</label>
            <InputNumber id="item-quantity" class="form-control" @bind-Value="model.Quantity" />
            <ValidationMessage For="@(() => model.Quantity)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Categories</label>
            <div>
                @foreach (var option in categoryOptions)
                {
                    <div class="form-check">
                        <InputCheckbox class="form-check-input"
                                       id="@($"cat_{option.Category}")"
                                       @bind-Value="option.IsSelected" />
                        <label class="form-check-label" for="@($"cat_{option.Category}")">@option.Category</label>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(categoryError))
            {
                <div class="text-danger">@categoryError</div>
            }
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <button type="submit" class="btn btn-primary">@(IsEditMode ? "Update" : "Create")</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
</div>

@code {
    [Parameter]
    public UInt64? ListingId { get; set; }

    [Parameter]
    public EventCallback<UInt64?> OnSuccess { get; set; }

    private string? categoryError;
    private string? error;
    private ListingModel model = new();
    private List<CategoryOption> categoryOptions = new();

    private bool IsEditMode => ListingId is not null;

    protected override async Task OnInitializedAsync()
    {
        //Console.WriteLine("\n\n\n\n\nInitialized\n\n\n\n\n");

        InitializeCategories();

        if (IsEditMode)
        {
            await LoadListing();
        }
    }

    private void InitializeCategories()
    {
        categoryOptions = Enum.GetValues<Database.Data.ListingCategory>()
            .Where(cat => cat != Database.Data.ListingCategory.none)
            .Select(cat => new CategoryOption { Category = cat })
            .ToList();
    }

    private async Task LoadListing()
    {
        Database.Data.Listing? listing = await DataService.GetListingAsync(ListingId!.Value);
        if (listing is null)
        {
            error = "Listing not found.";
            return;
        }

        model.ItemName = listing.ItemName;
        model.ItemDescription = listing.ItemDescription;
        model.Image = listing.Image;
        model.Price = (int)listing.Price;
        model.Quantity = (int)listing.Quantity;

        foreach (var option in categoryOptions)
        {
            option.IsSelected = listing.Category.HasFlag(option.Category);
        }
    }

    private async Task HandleSubmit()
    {
        //Console.WriteLine("\n\n\n\n\nMade it This Far\n\n\n\n\n");

        error = null;
        categoryError = null;

        Database.Data.ListingCategory category = Database.Data.ListingCategory.none;
        foreach (var option in categoryOptions)
        {
            if (option.IsSelected)
            {
                category |= option.Category;
            }
        }

        if (category == Database.Data.ListingCategory.none)
        {
            categoryError = "Please select at least one category.";
            return;
        }

        UInt64? createdId = null;
        bool success = false;

        if (IsEditMode)
        {
            success = await DataService.UpdateListingAsync(
                ListingId!.Value,
                model.ItemName,
                model.ItemDescription,
                category,
                model.Image,
                (UInt32)model.Price,
                (UInt32)model.Quantity);
            createdId = ListingId;
        }
        else
        {
            var newId = await DataService.CreateListingAsync(
                model.ItemName,
                model.ItemDescription,
                category,
                model.Image,
                (UInt32)model.Price,
                (UInt32)model.Quantity);

            success = newId != 0;
            createdId = newId;
        }

        if (success)
        {
            //Console.WriteLine("\n\n\n\n\nsuccess\n\n\n\n\n");
            await OnSuccess.InvokeAsync(createdId);
        }
        else
        {
            //Console.WriteLine("\n\n\n\n\nfailure\n\n\n\n\n");
            error = IsEditMode ? "Failed to update listing." : "Failed to create listing.";
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin/listingdashboard");
    }

    private class ListingModel
    {
        [Required]
        public string ItemName { get; set; } = string.Empty;

        [Required]
        public string ItemDescription { get; set; } = string.Empty;

        [Required]
        public string Image { get; set; } = string.Empty;

        [Range(1, uint.MaxValue, ErrorMessage = "Price must be greater than 0.")]
        public int Price { get; set; }

        [Range(1, uint.MaxValue, ErrorMessage = "Quantity must be greater than 0.")]
        public int Quantity { get; set; }
    }

    private sealed class CategoryOption
    {
        public Database.Data.ListingCategory Category { get; set; }
        public bool IsSelected { get; set; }
    }
}